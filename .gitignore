node_modules/
dist/
*.log
.env
server/.env
web/.env
*.local
.DS_Store
*.tsbuildinfo
data/
server/data/
.scratch/

# 打包用的本地工具链（JDK、Android SDK），几百兆，不进版本库
.toolchain/

# 桌面端：esbuild 打出来的服务端单文件、electron-builder 的产物
desktop/out/
desktop/release/

# 自动更新用的 GitHub 只读令牌。会被写进安装包，但别进版本库
.update-token

# 手机端：Gradle 的构建目录和本机路径，每台机器不一样
mobile/android/build/
mobile/android/app/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/keystore.properties
# 打包时从 node_modules 复制出来的原生插件（见 mobile/tools/prepare-android.mjs）
mobile/android/plugins/
*.keystore
*.jks

# ---- 关键位引擎（Python sidecar） ----
# 虚拟环境、PyInstaller 产物、缓存都不进版本库
sidecar/.venv/
sidecar/output/
sidecar/out/
sidecar/build/
sidecar/dist/
__pycache__/
*.pyc

# 但引擎自带的模型 / 校准表 / 复权因子必须进库：
# 少一个文件，安装版就没有概率，而且界面上只会显示成「模型缺失」，没人知道该去哪找
!sidecar/data/
!sidecar/data/**

# 运行时文件：记住的本地数据目录（每台机器不一样）
server/data-dir.json

# AI 交易的策略和决策日志。跟着 XFRINE_HOME 走，仓库里跑时落在 server/ 下
server/ai-strategy.json
server/ai-strategy.json.tmp
server/ai-decisions.jsonl

# 回测用的历史 K 线缓存（每个合约每种周期几十兆，重拉一次几秒钟）
server/quant-kline/

# 策略库：每台机器上编出来的策略，不进版本库
server/quant-strategies.json
server/quant-strategies.json.tmp

# 引擎目录里的样例数据与评测产物：体积大、和机器上的行情无关，不进版本库
# （模型、校准表、复权因子在上面已经显式放行）
sidecar/data/klines/
sidecar/data/dataset/
sidecar/data/fetch.log
