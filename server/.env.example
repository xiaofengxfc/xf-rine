# Gate.io USDT 永续
# 每个环境一套密钥，切环境不用重填。GATE_ENV 决定当前打哪个环境。

# testnet = 模拟盘（假钱，REST 走 api-testnet.gateapi.io）
# live    = 实盘（真钱，REST 走 api.gateio.ws）
# 行情 WebSocket 两种环境都连主网。
GATE_ENV=testnet

# 测试网密钥 —— 在 https://www.gate.io/testnet 申请
GATE_TESTNET_KEY=
GATE_TESTNET_SECRET=

# 主网密钥 —— 在 https://www.gate.io/myaccount/api_key_manage 申请
# 权限勾「合约交易 · 读写」就够，不要开提现。
GATE_LIVE_KEY=
GATE_LIVE_SECRET=

# 下单总开关。false 时服务端拒绝一切下单/撤单/改杠杆请求，只读看盘。
LIVE_TRADING=false

# 风控硬上限（服务端强制，页面绕不过去）
MAX_ORDER_NOTIONAL_USDT=500
MAX_LEVERAGE=20
MAX_CONTRACTS_PER_ORDER=0

PORT=8787
