# 交易所：gate 或 bitget。二选一，同一时间只连一家。
# 合约名、张数、持仓、挂单、保护单的整套口径都跟着它走；换一家＝换一个账户。
EXCHANGE=gate

# 环境：testnet = 模拟盘（假钱），live = 实盘（真钱）
GATE_ENV=testnet

# ---------- Gate.io USDT 永续 ----------
# 每个环境一套密钥，切环境不用重填。
# testnet 打 api-testnet.gateapi.io；live 打 api.gateio.ws；行情 WebSocket 两种环境都连主网。

# 测试网密钥 —— 在 https://www.gate.io/testnet 申请
GATE_TESTNET_KEY=
GATE_TESTNET_SECRET=

# 主网密钥 —— 在 https://www.gate.io/myaccount/api_key_manage 申请
# 权限勾「合约交易 · 读写」就够，不要开提现。
GATE_LIVE_KEY=
GATE_LIVE_SECRET=

# ---------- Bitget USDT 永续 ----------
# 在 https://www.bitget.com/zh-CN/account/newapi 申请，权限勾「合约交易 · 读写」，不要开提现。
# 创建密钥时自己设的那串口令（Passphrase）就是下面这第三样 —— 少它一样，
# 读账户和下单都会被拒（报「无效的 PASSPHRASE」），而密钥本身看着是配好的。
#
# 模拟盘用同一套接口地址（api.bitget.com），请求头带 PAPTRADING 切到模拟账户；
# 模拟盘的密钥要单独创建，拿实盘密钥去连模拟盘会认证失败。

BITGET_TESTNET_KEY=
BITGET_TESTNET_SECRET=
BITGET_TESTNET_PASSPHRASE=

BITGET_LIVE_KEY=
BITGET_LIVE_SECRET=
BITGET_LIVE_PASSPHRASE=

# 下单总开关。false 时服务端拒绝一切下单/撤单/改杠杆请求，只读看盘。
LIVE_TRADING=false

# 风控硬上限（服务端强制，页面绕不过去）
MAX_ORDER_NOTIONAL_USDT=500
MAX_LEVERAGE=20
MAX_CONTRACTS_PER_ORDER=0

# 行情 WebSocket 先走哪条路：auto（默认，按实测快慢自动选）/ proxy / direct。
# 通常不用管。TUN 模式下行情一直掉线时，设成 direct 试试：
# TUN 已经把流量接管了，再叠一层 HTTP 代理，长连接反而容易被节点掐掉。
# 这里只是把它排在最前面，另一条仍然是后备 —— 选的这条不通，行情会自己换过去。
XF_WS_ROUTE=auto

PORT=8787
