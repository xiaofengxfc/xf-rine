{
  "name": "mobile",
  "private": true,
  "version": "1.2.4",
  "description": "巡风 · Android 独立运行端",
  "scripts": {
    "bundle": "node tools/bundle-server.mjs",
    "sync": "cap sync android",
    "open": "cap open android",
    "assets": "capacitor-assets generate --android && node tools/generate-icons.mjs",
    "apk": "node tools/bundle-server.mjs && cap sync android && node tools/prepare-android.mjs && node tools/gradle.mjs assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.6.0",
    "@capawesome/capacitor-nodejs": "^0.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
