{
  "name": "xf-rine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm -F server dev\" \"pnpm -F web dev\"",
    "build": "pnpm -F web build",
    "start": "pnpm -F server start",
    "typecheck": "pnpm -F server typecheck && pnpm -F web typecheck",
    "check:all": "node tools/check-all.mjs",
    "check:ci": "pnpm typecheck && node tools/check-all.mjs",
    "check:sizing": "pnpm -F web check:sizing",
    "check:units": "pnpm -F web check:units",
    "check:paint": "pnpm -F server exec tsx ../web/scripts/check-paint.ts",
    "check:candles": "pnpm -F server exec tsx ../web/scripts/check-candles.ts",
    "check:patterns": "pnpm -F server exec tsx ../web/scripts/check-patterns.ts",
    "check:patterns-context": "pnpm -F server exec tsx ../web/scripts/check-pattern-context.ts",
    "check:patterns-walk": "pnpm -F server exec tsx ../web/scripts/check-pattern-walk.ts",
    "check:patterns-fade": "pnpm -F server exec tsx ../web/scripts/check-pattern-fade.ts",
    "check:patterns-threshold": "pnpm -F server exec tsx ../web/scripts/pattern-threshold.ts",
    "check:pattern-index": "pnpm -F server exec tsx ../web/scripts/check-pattern-index.ts",
    "stats:patterns": "pnpm -F server exec tsx ../web/scripts/pattern-stats.ts",
    "stats:patterns-context": "pnpm -F server exec tsx ../web/scripts/pattern-context.ts",
    "fetch:patterns-context": "pnpm -F server exec tsx ../web/scripts/fetch-pattern-context.ts",
    "levels:timeline": "node web/scripts/run-levels-timeline.mjs",
    "check:viewport": "pnpm -F server exec tsx ../web/scripts/check-viewport.ts",
    "check:errors": "pnpm -F server exec tsx scripts/check-errors.ts",
    "check:protect": "pnpm -F server exec tsx ../web/scripts/check-protection.ts",
    "check:ws-route": "pnpm -F server check:ws-route",
    "check:ws-failover": "pnpm -F server check:ws-failover",
    "check:update": "pnpm -F server check:update",
    "check:update-flow": "pnpm -F server exec tsx ../web/scripts/check-update-flow.ts",
    "check:levels": "pnpm -F server exec tsx scripts/check-levels.ts",
    "check:data": "pnpm -F server exec tsx scripts/check-data.ts",
    "check:pick": "pnpm -F server exec tsx scripts/check-pick.ts",
    "check:ai": "pnpm -F server exec tsx scripts/check-ai.ts",
    "check:daily-pnl": "pnpm -F server exec tsx scripts/check-daily-pnl.ts",
    "check:sidecar-http": "python sidecar/scripts/check_http_api.py",
    "check:quant": "pnpm -F server exec tsx scripts/check-quant.ts",
    "check:prompt-baseline": "pnpm -F server exec tsx scripts/check-prompt-baseline.ts",
    "research": "pnpm -F server exec tsx scripts/research.ts",
    "pack:sidecar": "node sidecar/tools/build-exe.mjs",
    "pack:win": "pnpm -F web build && node sidecar/tools/build-exe.mjs && pnpm --filter ./desktop dist",
    "pack:android": "pnpm -F web build && pnpm --filter ./mobile apk"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
