{
  "name": "xf-rine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm -F server dev\" \"pnpm -F web dev\"",
    "build": "pnpm -F web build",
    "start": "pnpm -F server start",
    "typecheck": "pnpm -F server typecheck && pnpm -F web typecheck",
    "check:paint": "pnpm -F server exec tsx ../web/scripts/check-paint.ts",
    "check:candles": "pnpm -F server exec tsx ../web/scripts/check-candles.ts",
    "check:viewport": "pnpm -F server exec tsx ../web/scripts/check-viewport.ts",
    "check:errors": "pnpm -F server exec tsx scripts/check-errors.ts",
    "pack:win": "pnpm -F web build && pnpm --filter ./desktop dist",
    "pack:android": "pnpm -F web build && pnpm --filter ./mobile apk"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
